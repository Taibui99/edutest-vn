generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  role          String
  avatarUrl     String?
  school        String?
  grade         String?
  bio           String?
  isBlocked        Boolean  @default(false)
  lastLoginAt      DateTime?
  resetToken       String?  @unique
  resetTokenExpiry DateTime?
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  exams              Exam[]
  submissions        Submission[]
  attempts           Attempt[]
  notifications      Notification[]
  classroomsAsTeacher Classroom[]       @relation("TeacherClassrooms")
  classroomsAsMember  ClassMember[]
  questionBankItems   QuestionBankItem[]
  appLogs             AppLog[]
  reports             Report[]
  reportsHandled      Report[]          @relation("ReportHandledBy")
  aiImportLogs        AiImportLog[]

  @@index([email])
}

model Classroom {
  id          String   @id @default(cuid())
  name        String
  description String?
  subject     String?
  grade       String?
  joinCode    String   @unique
  teacherId   String
  teacher     User     @relation("TeacherClassrooms", fields: [teacherId], references: [id], onDelete: Cascade)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     ClassMember[]
  assignments ExamAssignment[]
  @@index([teacherId])
  @@index([joinCode])
}

model ClassMember {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  studentId   String
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now())
  @@unique([classroomId, studentId])
  @@index([studentId])
}

model ExamAssignment {
  id          String   @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  examId      String
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  dueDate     DateTime?
  assignedAt  DateTime @default(now())
  @@unique([classroomId, examId])
}

model Exam {
  id                 String   @id @default(cuid())
  title              String
  subject            String
  description        String?
  durationMinutes    Int
  joinCode           String   @unique
  status             String   @default("published")
  allowGuestAttempts Boolean  @default(true)
  shuffleQuestions   Boolean  @default(false)
  shuffleAnswers     Boolean  @default(false)
  maxAttempts        Int       @default(1)
  showAnswers        Boolean   @default(true)
  showScoreImmediately Boolean @default(true)
  proctorMode        String    @default("off")
  openAt             DateTime?
  closeAt            DateTime?
  hidden             Boolean   @default(false)
  deletedAt          DateTime?
  teacherId          String
  teacher            User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  questions          Question[]
  submissions        Submission[]
  attempts           Attempt[]
  guestParticipants  GuestParticipant[]
  assignments        ExamAssignment[]
  reports            Report[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@index([teacherId])
  @@index([joinCode])
  @@index([subject])
}

model Question {
  id          String   @id @default(cuid())
  examId      String
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  type        String   @default("mcq")
  text        String
  options     String[]
  answer      String
  grading     Json?
  explanation String?
  points      Float    @default(1)
  order       Int
  createdAt   DateTime @default(now())
  @@index([examId])
}

model GuestParticipant {
  id           String   @id @default(cuid())
  examId       String
  exam         Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  name         String
  className    String
  tokenHash    String   @unique
  startedAt    DateTime @default(now())
  submittedAt  DateTime?
  createdAt    DateTime @default(now())
  submission   Submission?
  attempts     Attempt[]
  @@index([examId])
}

/// GĐ1 — Một lần làm bài, do SERVER quản lý hoàn toàn.
///
/// Trước đây thời gian, thứ tự câu và thứ tự đáp án đều do client quyết định
/// (`Math.random()` ở client, `durationSeconds` gửi lên khi nộp) nên server
/// không có cách nào kiểm chứng. Model này là nguồn sự thật:
///
/// - `startedAt` / `deadlineAt`: server tính lúc bắt đầu, client chỉ được ĐỌC.
/// - `seed` + `questionOrder` / `optionOrder`: server sinh (Fisher–Yates có
///   seed), client chỉ render đúng thứ tự đó.
/// - `activeKey`: khoá UNIQUE bắt buộc chỉ được có MỘT attempt đang mở cho một
///   học sinh — chặn thi song song. Khi xong thì xoá (`null`); Postgres cho
///   phép nhiều `null` trong cột UNIQUE nên attempt đã nộp vẫn giữ nguyên.
model Attempt {
  id                 String            @id @default(cuid())
  examId             String
  exam               Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId          String?
  student            User?             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guestParticipantId String?           @unique
  guestParticipant   GuestParticipant? @relation(fields: [guestParticipantId], references: [id], onDelete: Cascade)

  /// Số sinh hoán vị — cùng seed ⇒ cùng thứ tự câu/đáp án.
  seed          Int
  /// `Int[]` — thứ tự hiển thị các câu (index vào danh sách câu gốc).
  questionOrder Json
  /// `{ [questionId]: Int[] }` — thứ tự hiển thị đáp án của từng câu.
  optionOrder   Json?

  startedAt     DateTime @default(now())
  /// Server cộng thêm `Exam.durationMinutes` — client không được tự tính.
  deadlineAt    DateTime
  /// Đã nộp chưa (NULL = vẫn đang làm).
  submittedAt   DateTime?
  /// Khóa chặn thi song song: `student:<id>` hoặc `guest:<tokenHash>`.
  activeKey     String?  @unique

  submission    Submission?
  proctorEvents ProctorEvent[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([examId, studentId])
  @@index([examId])
  @@index([activeKey])
}

model Submission {
  id                 String            @id @default(cuid())
  examId             String
  exam               Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId          String?
  student            User?             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guestParticipantId String?           @unique
  guestParticipant   GuestParticipant? @relation(fields: [guestParticipantId], references: [id], onDelete: Cascade)
  /// Liên kết về lần làm bài — trước GĐ1 không có nên để nullable.
  attemptId          String?           @unique
  attempt            Attempt?          @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  answers            Json
  score              Float
  correctCount       Int
  totalQuestions     Int
  durationSeconds    Int
  /// GĐ2 — cờ rủi ro do `lib/integrity.ts` tính lúc nộp. Chỉ để giáo viên xem:
  /// KHÔNG trừ điểm, KHÔNG từ chối nộp bài (ROADMAP — Chống gian lận).
  violationCount Int     @default(0)
  /// Thang 0–100, cộng dồn theo mức nghiêm trọng của từng sự kiện.
  riskScore      Int     @default(0)
  /// `none` | `low` | `medium` | `high`.
  riskLevel      String  @default("none")
  /// Bị nộp tự động vì đạt ngưỡng vi phạm — server tự suy ra từ `violationCount`.
  autoSubmitted  Boolean @default(false)
  /// SHA-256 của IP gộp muối — chỉ để gom cùng một người, không lưu IP thô.
  ipHash         String?
  submittedAt        DateTime          @default(now())
  @@index([studentId])
  @@index([examId, studentId])
  @@index([examId])
  @@index([submittedAt])
}

/// GĐ2 — nhật ký vi phạm trong một lần làm bài.
///
/// Chỉ ghi log + gắn cờ cho giáo viên xem timeline: **không** tự 0 điểm,
/// **không** từ chối nộp bài (ROADMAP — "Chống gian lận khi thi").
model ProctorEvent {
  id        String   @id @default(cuid())
  attemptId String
  attempt   Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  /// Tên sự kiện — phải nằm trong whitelist `ProctorEventType` của `lib/integrity.ts`.
  type      String
  /// `low` | `medium` | `high` — server tự suy ra từ `type`, không nhận từ client.
  severity  String
  /// Chi tiết phụ (vd: số lần, nhãn sự kiện) — không chứa dữ liệu nhạy cảm.
  detail    String?
  createdAt DateTime @default(now())

  @@index([attemptId])
  @@index([type])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([userId, read])
}

model QuestionBankItem {
  id          String   @id @default(cuid())
  teacherId   String
  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject     String
  type        String   @default("mcq")
  text        String
  options     String[]
  answer      String
  grading     Json?
  explanation String?
  points      Float    @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([teacherId])
  @@index([teacherId, subject])
}

model AppLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type      String
  message   String
  meta      Json?
  createdAt DateTime @default(now())
  @@index([type])
  @@index([actorId])
  @@index([createdAt])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Report {
  id          String    @id @default(cuid())
  reporterId  String?
  reporter    User?     @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  examId      String?
  exam        Exam?     @relation(fields: [examId], references: [id], onDelete: SetNull)
  type        String
  description String
  status      String    @default("pending")
  handledById String?
  handledBy   User?     @relation("ReportHandledBy", fields: [handledById], references: [id], onDelete: SetNull)
  handledAt   DateTime?
  resolution  String?
  deletedAt   DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  @@index([status])
  @@index([createdAt])
  @@index([reporterId])
  @@index([examId])
}

model AiImportLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  provider   String
  status     String
  model      String?
  prompt     String?
  error      String?
  meta       Json?
  createdAt  DateTime @default(now())
  @@index([userId])
  @@index([createdAt])
  @@index([status, createdAt])
}
